# FCRS backend environment variables.
# Copy this file to .env and fill in real values. NEVER commit .env.
# Every name below is documented with a PLACEHOLDER only — no real
# credentials, tokens, connection strings, or inbox addresses belong here.

# ---- Supabase Postgres — the only lead data store ----
# Session-pooler connection string from Supabase:
# Project Settings -> Database -> Connection string -> URI.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ---- EmailJS — transactional email, called SERVER-SIDE ----
# Requires "Allow EmailJS API for non-browser applications" ENABLED
# (EmailJS dashboard -> Account -> Security). Treat ALL of these as secrets;
# none of them are exposed to the browser.
EMAILJS_SERVICE_ID=your-emailjs-service-id
EMAILJS_PUBLIC_KEY=your-emailjs-public-key
EMAILJS_PRIVATE_KEY=your-emailjs-private-key
EMAILJS_TEMPLATE_ID_CONFIRMATION=your-confirmation-template-id
EMAILJS_TEMPLATE_ID_INTERNAL=your-internal-notification-template-id

# ---- Supabase Database Webhook authentication ----
# Shared secret sent by the webhook as the x-webhook-secret header and
# compared constant-time by POST /internal/lead-created. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEAD_WEBHOOK_SECRET=your-64-char-random-hex-secret

# ---- FCRS team inbox that receives the full lead-detail notification ----
INTERNAL_NOTIFICATION_EMAIL=leads@example.com

# ---- Duplicate-submission identity-check window, in minutes ----
DUPLICATE_WINDOW_MINUTES=30

# ---- Local dev server port ----
PORT=3000

# ---- Browser origin allowed by CORS ----
ALLOWED_ORIGIN=http://localhost:4321

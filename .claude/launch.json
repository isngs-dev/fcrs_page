{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fcrs-landing",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/fcrs-landing",
        "run",
        "dev"
      ],
      "port": 4321
    },
    {
      "name": "admin-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/admin-web",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "widget-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/widget",
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "api-local",
      "runtimeExecutable": "venv/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "api.app:create_app",
        "--factory",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--app-dir",
        "services/api/src"
      ],
      "port": 8000
    }
  ]
}
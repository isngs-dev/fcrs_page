# FCRS frontend environment variables.
# Copy this file to .env and fill in real values. NEVER commit .env.
# Astro only exposes vars prefixed PUBLIC_ to client-side code.

# Absolute origin of the deployed backend API (e.g. https://api.fcrsga.com).
# Leave unset for local dev — the Vite dev-server proxy in astro.config.mjs
# forwards relative /api/* calls to http://localhost:3000 instead. Leave
# unset in production ONLY if frontend and backend share one domain with an
# /api/* rewrite rule; otherwise this must be set or the estimate form
# cannot reach the backend.
PUBLIC_API_URL=

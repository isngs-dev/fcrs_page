# Landing-page build environment. Copy to .env for local builds; on the host
# (Render) set the same variable in the site's environment settings.
# Astro only exposes vars prefixed PUBLIC_ to client-side code.

# The chatbot platform's form-intake URL for this client: admin console ->
# Outreach -> Lead intake -> "Form URL" (https://<api>/public/intake/forms/<token>).
# Required: `npm run build` fails without it.
PUBLIC_INTAKE_URL=

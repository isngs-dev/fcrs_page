---
---
<footer class="site-footer">
  <div class="grid">
    <div>
      <div class="brand">
        <span class="brand-tile"><i class="fa-solid fa-house-chimney"></i></span>
        <span class="brand-name">
          <span class="line1">FIRST CLASS</span>
          <span class="line2">ROOFING &amp; SOLAR</span>
        </span>
      </div>
      <p class="blurb">
        Trusted residential &amp; commercial roofing built for Southern
        weather. Licensed, insured &amp; bonded in Alabama and Georgia.
      </p>
    </div>

    <div>
      <h4>Contact</h4>
      <ul>
        <li>
          <a href="tel:+19898434628"><i class="fa-solid fa-phone"></i> (989) 843-4628</a>
        </li>
        <li>
          <a href="mailto:claims@fcrsga.com"><i class="fa-solid fa-envelope"></i> claims@fcrsga.com</a>
        </li>
        <li class="static-line"><i class="fa-solid fa-location-dot"></i> Serving Alabama &amp; Georgia</li>
      </ul>
    </div>

    <div>
      <h4>Services</h4>
      <ul>
        <li><a href="#services" data-scroll>Residential Roofing</a></li>
        <li><a href="#services" data-scroll>Commercial Roofing</a></li>
        <li><a href="#top" data-scroll>Emergency Repair</a></li>
        <li><a href="#top" data-scroll>Free Inspection</a></li>
      </ul>
    </div>

    <div>
      <h4>Get Started</h4>
      <a href="#top" data-scroll class="cta-btn">
        <i class="fa-solid fa-clipboard-check"></i> Free Estimate
      </a>
    </div>
  </div>

  <div class="bottom-bar">
    <span>© 2026 First Class Roofing &amp; Solar. All rights reserved.</span>
    <span class="website-by">Website by <img src="/assets/isn-logo.png" alt="iSN" /></span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy-2);
    color: var(--dark-panel-subtext);
    padding: var(--footer-pad);
  }

  .grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 36px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #fff;
    margin-bottom: 14px;
  }

  .brand-tile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 11px;
    background: var(--orange);
    color: #fff;
    font-size: 18px;
  }

  .brand-name {
    line-height: 1;
  }

  .line1 {
    display: block;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 17px;
  }

  .line2 {
    display: block;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 2.5px;
    color: var(--gold);
    margin-top: 2px;
  }

  .blurb {
    font-size: 14px;
    line-height: 1.65;
    max-width: 32ch;
  }

  h4 {
    font-family: var(--font-heading);
    font-weight: 700;
    color: #fff;
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  ul {
    list-style: none;
    display: grid;
    gap: 11px;
    font-size: 14px;
  }

  ul a {
    color: var(--footer-link);
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }

  ul a:hover {
    color: #fff;
  }

  ul a i {
    color: var(--green);
    width: 16px;
  }

  .static-line {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }

  .static-line i {
    color: var(--green);
    width: 16px;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: var(--orange);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 14px;
    padding: 12px 20px;
    border-radius: 11px;
  }

  .cta-btn:hover {
    background: var(--orange-d);
    color: #fff;
  }

  .bottom-bar {
    max-width: 1200px;
    margin: 38px auto 0;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-size: 12.5px;
  }

  .website-by {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--footer-meta);
  }

  .website-by img {
    height: 20px;
    width: auto;
    filter: brightness(0) invert(1);
    opacity: 0.85;
  }
</style>

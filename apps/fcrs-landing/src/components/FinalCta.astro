---
---
<section id="final-cta" class="final-cta">
  <div aria-hidden="true" class="photo"></div>
  <div aria-hidden="true" class="gradient"></div>
  <div aria-hidden="true" class="radial"></div>
  <div data-reveal class="content">
    <span class="eyebrow">// Let&rsquo;s Do Business</span>
    <h2>Don&rsquo;t Wait Until a Small Leak Becomes an Expensive Repair.</h2>
    <p class="lead">Protect your property today with a free, professional roof assessment.</p>

    <figure class="quote-card">
      <div class="stars">★★★★★</div>
      <blockquote>
        &ldquo;Absolutely amazing company. Josh and his team are very
        knowledgeable, no pressure, and the hardest working roofers I have
        met. This is the team to trust!&rdquo;
      </blockquote>
      <figcaption><strong>Ben Williams</strong> &middot; Verified Google Review</figcaption>
    </figure>

    <div class="actions">
      <a href="tel:+19898434628" class="call-btn">
        <i class="fa-solid fa-phone-volume"></i> Call Now: (989) 843-4628
      </a>
      <a href="#top" data-scroll class="outline-btn">
        <i class="fa-solid fa-clipboard-check"></i> Claim Your Free Estimate
      </a>
    </div>
  </div>
</section>

<style>
  .final-cta {
    position: relative;
    background: var(--navy);
    padding: var(--final-cta-pad);
    overflow: hidden;
  }

  .photo {
    position: absolute;
    inset: 0;
    background: url("/images/final-cta-bg.jpg") center 35% / cover;
  }

  .gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(21, 34, 56, 0.62), rgba(21, 34, 56, 0.78));
  }

  .radial {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 82% 18%, rgba(255, 153, 0, 0.2), transparent 55%);
  }

  .content {
    position: relative;
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--gold);
  }

  .content h2 {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(2rem, 4vw, 3rem);
    color: #fff;
    line-height: 1.1;
    margin-top: 14px;
    letter-spacing: -0.5px;
    text-wrap: balance;
    text-shadow: 0 2px 24px rgba(10, 18, 34, 0.5);
  }

  .lead {
    color: var(--final-cta-body);
    font-size: var(--lead);
    line-height: 1.6;
    margin-top: 18px;
    text-shadow: 0 1px 12px rgba(10, 18, 34, 0.4);
  }

  .quote-card {
    max-width: 620px;
    margin: 32px auto 0;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(6px);
    border-radius: 18px;
    padding: 26px 30px;
  }

  .quote-card .stars {
    color: var(--gold);
    font-size: 15px;
    letter-spacing: 2px;
    margin-bottom: 12px;
  }

  .quote-card blockquote {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(1.05rem, 1.8vw, 1.28rem);
    line-height: 1.5;
    color: #fff;
  }

  .quote-card figcaption {
    margin-top: 16px;
    font-size: 13.5px;
    color: var(--final-cta-caption);
  }

  .quote-card figcaption strong {
    color: #fff;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
    margin-top: 34px;
  }

  .call-btn {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    background: var(--orange);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    padding: 16px 30px;
    border-radius: 13px;
    box-shadow: 0 12px 30px rgba(255, 153, 0, 0.4);
    transition: transform 0.18s ease, background 0.18s ease;
  }

  .call-btn:hover {
    transform: translateY(-2px);
    background: var(--orange-d);
  }

  .outline-btn {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    background: transparent;
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    padding: 16px 30px;
    border-radius: 13px;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    transition: background 0.18s ease, border-color 0.18s ease;
  }

  .outline-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: #fff;
    color: #fff;
  }
</style>

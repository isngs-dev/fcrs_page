#!/usr/bin/env python
"""Pre-commit secret scan.

Blocks a commit whose staged content contains an obvious hardcoded
credential (AWS key, private key, Anthropic/OpenAI-style key, or a generic
`api_key|secret|password|token = "..."` literal), or whose staged file is
named like a scratch secrets file (`passwords.txt`, `secrets.txt`,
`credentials.txt`, ...) -- prompted by a `passwords.txt` file that sat
committed in this repo's history for a while before being (incompletely --
deleting a file in a new commit does NOT remove it from history) removed.

Mirrors `.claude/hooks/protect_paths.py`'s SECRET_PATTERNS so a manual
`git commit` is held to the same standard as a Claude Code edit. Escape
hatch: `git commit --no-verify` (standard git behavior, not overridden here)
for a genuine false positive.

Setup (one-time per clone):
    git config core.hooksPath .githooks
"""
from __future__ import annotations

import re
import subprocess
import sys

SECRET_PATTERNS: list[tuple[re.Pattern[str], str]] = [
    (re.compile(r"AKIA[0-9A-Z]{16}"), "AWS access key id"),
    (re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----"), "private key"),
    (re.compile(r"sk-ant-[A-Za-z0-9_-]{20,}"), "Anthropic API key"),
    (re.compile(r"\bsk-[A-Za-z0-9]{32,}"), "OpenAI-style API key"),
    (
        re.compile(r"(?i)(?:api[_-]?key|secret|password|token)\s*[:=]\s*['\"][^'\"\n]{12,}['\"]"),
        "hardcoded credential",
    ),
]

# Files allowed to carry example/placeholder secrets.
SECRET_SCAN_EXEMPT = {".env.example", "secrets.md", "skill.md"}

# Filenames that are never appropriate to commit, regardless of content --
# exactly the shape of file this hook exists because of.
SUSPICIOUS_FILENAMES = re.compile(
    r"(?i)^(passwords?|secrets?|credentials?|api[_-]?keys?)\.(txt|json|ya?ml|csv)$"
)


def staged_files() -> list[str]:
    # encoding="utf-8" is mandatory here, not cosmetic: without it,
    # `text=True` alone decodes with the PLATFORM default (cp1252 on
    # Windows), which raises UnicodeDecodeError on the em-dashes/curly
    # quotes this codebase's comments use everywhere -- errors="replace"
    # is a second layer of defense so a genuinely binary/non-UTF-8 file
    # degrades to garbled text instead of crashing the hook outright.
    out = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
        check=True,
    )
    return [line for line in out.stdout.splitlines() if line]


def staged_content(path: str) -> str | None:
    result = subprocess.run(
        ["git", "show", f":{path}"],
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
    )
    if result.returncode != 0:
        return None
    return result.stdout


def main() -> int:
    problems: list[str] = []

    for path in staged_files():
        basename = path.rsplit("/", 1)[-1]
        if basename.lower() in SECRET_SCAN_EXEMPT:
            continue

        if SUSPICIOUS_FILENAMES.match(basename):
            problems.append(f"{path}: filename looks like a scratch secrets file")
            continue

        content = staged_content(path)
        if content is None:
            continue  # binary or unreadable -- not this hook's job to scan

        for pattern, label in SECRET_PATTERNS:
            if pattern.search(content):
                problems.append(f"{path}: possible {label}")
                break

    if problems:
        sys.stderr.write("BLOCKED: staged content looks like it contains a secret:\n")
        for problem in problems:
            sys.stderr.write(f"  - {problem}\n")
        sys.stderr.write(
            "\nMove real secrets to env vars / encrypted-at-rest config instead.\n"
            "If this is a genuine false positive: git commit --no-verify\n"
        )
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
